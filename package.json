{
  "name": "claude-manager",
  "version": "0.1.0",
  "private": true,
  "description": "1인 CEO를 위한 Skill 기반 멀티 에이전트 오케스트레이션 시스템",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "src/shared",
    "src/backend",
    "src/cli"
  ],
  "scripts": {
    "server:start": "tsx src/backend/server.ts",
    "server:dev": "tsx watch src/backend/server.ts",
    "cli": "tsx src/cli/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/backend/db/migrate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.2",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
