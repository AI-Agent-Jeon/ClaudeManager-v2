{
  "name": "claude-manager",
  "version": "0.1.0",
  "private": true,
  "description": "1인 CEO를 위한 Skill 기반 멀티 에이전트 오케스트레이션 시스템",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "src/shared",
    "src/backend",
    "src/cli"
  ],
  "scripts": {
    "server:start": "tsx --env-file-if-exists=.env src/backend/server.ts",
    "server:dev": "tsx watch --env-file-if-exists=.env src/backend/server.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli/index.ts",
    "build": "tsup",
    "frontend:dev": "vite",
    "frontend:build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/frontend/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "echo \"마이그레이션은 손으로 쓴다 — src/backend/migrations/*.sql (DES-003 §9). drizzle-kit generate는 CHECK 제약·부분 인덱스·FTS5를 잃는다\" && exit 1",
    "db:migrate": "tsx --env-file-if-exists=.env src/backend/db/migrate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.5",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
