# ClaudeManager v2 — 환경 변수 템플릿
# 이 파일을 .env로 복사해 사용한다. .env는 gitignore 대상이다.
# npm scripts가 --env-file-if-exists=.env로 읽는다 (server:start · server:dev · cli · db:migrate).
# .env가 없으면 Node가 안내만 출력하고 그대로 진행한다 — 필수 파일이 아니다.
# Node 22.9+ 필요 (package.json engines).
# 상수 정의 원본: DES-009 v3.1 §상수

# --- 서버 ---
# Phase 1은 루프백 전용이다. 외부 노출은 Phase 2 터널링(D-19) 이후.
CM_HOST=127.0.0.1
CM_PORT=3000

# --- 데이터베이스 ---
CM_DB_PATH=./data/claude-manager.db

# --- 인증 (DES-001 ADR-005) ---
# 미설정 시 서버가 최초 기동에서 랜덤 시크릿을 생성해 콘솔에 출력한다.
# 출력된 값을 여기에 옮겨 적으면 다음 기동부터 재사용된다.
CM_AUTH_SECRET=
CM_JWT_EXPIRES=7d
